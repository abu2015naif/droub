rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == "abu2015naif@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function checkUserPermission(userData, permission) {
      return userData.role == 'admin' ||
             (
               (!('permissions' in userData) || userData.permissions == null) ?
               (userData.role in ['manager', 'staff']) :
               (userData.permissions.get(permission, false) == true)
             );
    }

    function hasPermission(permission) {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == "abu2015naif@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         checkUserPermission(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, permission))
      );
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: /users/{userId}
    // Fields: uid, email, displayName, photoURL, role, permissions
    //
    // Collection: /products/{productId}
    // Fields: name, price, description, images, categories, stock_status
    //
    // Collection: /orders/{orderId}
    // Fields: userId, items, total, status, createdAt
    //
    // Collection: /banners/{bannerId}
    // Fields: url, title, subtitle, link, order, active, createdAt, updatedAt
    //
    // Collection: /showrooms/{showroomId}
    // Fields: city, locationLink, whatsapp, phone, active
    //
    // Collection: /bank_accounts/{accountId}
    // Fields: bankName, accountName, accountNumber, iban, active
    // ===============================================================

    function isValidBanner(data) {
      return data.url is string && data.url.size() > 0 &&
             data.order is number &&
             data.active is bool &&
             (!('title' in data) || data.title is string) &&
             (!('subtitle' in data) || data.subtitle is string) &&
             (!('link' in data) || data.link is string);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Master admin can do anything to any user
      allow write: if isOwner(userId) || ('email' in request.auth.token && request.auth.token.email == "abu2015naif@gmail.com");
      
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || ('email' in request.auth.token && request.auth.token.email == "abu2015naif@gmail.com");
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('products');
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if 
        isAdmin() || 
        hasPermission('orders') || 
        (
          resource.data.status == "awaiting-payment" &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.items == resource.data.items &&
          request.resource.data.userId == resource.data.userId
        );
      allow delete: if isAdmin() || hasPermission('orders');
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if isAdmin() || (hasPermission('banners') && isValidBanner(request.resource.data));
      allow delete: if isAdmin() || hasPermission('banners');
    }

    match /showrooms/{showroomId} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('showrooms');
    }

    match /bank_accounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('settings');
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasPermission('settings');
    }

    match /telemetry_sessions/{sessionId} {
      allow read: if hasPermission('settings');
      allow write: if true;
    }

    match /product_telemetry/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /devices/{deviceId} {
      allow create, update: if true;
      allow read: if isAdmin() || hasPermission('devices') || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create, read: if isAdmin() || hasPermission('devices');
      allow update, delete: if isAdmin();
    }
  }
}
